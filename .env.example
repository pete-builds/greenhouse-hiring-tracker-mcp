# Hiring Hub MCP - environment template. Every value is optional.
# Copy to .env next to docker-compose.yml (the container) to override.

# FASTMCP_HOST=0.0.0.0
# FASTMCP_PORT=3713

# Where the hub keeps its SQLite store. Default /hub/hub.db in the image,
# ~/.hiring-hub/hub.db everywhere else.
# HUB_DB_PATH=/hub/hub.db

# Re-sync any board older than this many hours, in the background. 0 = off.
# HUB_SYNC_INTERVAL_HOURS=12

# Per sync, at most this many per-job detail calls on ATSes whose list
# endpoint has no description (SmartRecruiters, BambooHR, Rippling, Workday).
# HUB_DETAIL_LIMIT=150

# Import the bundled starter companies into an empty store. 0 = start empty.
# HUB_AUTO_SEED=1

# A profile file (JSON or YAML, see profile.example.yaml) loaded on first
# start when no profile is stored yet. After that, set_profile owns it.
# HUB_PROFILE_PATH=/hub/profile.yaml

# Appended to the User-Agent so a vendor can reach you instead of blocking you,
# e.g. "contact: you@example.com".
# HUB_CONTACT=

# Optional: the original Anthropic tracker DB, for the anthropic_* history tools.
# TRACKER_DB_PATH=/data/tracker.db

# TZ=America/New_York
